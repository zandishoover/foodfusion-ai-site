# Supabase client values. The publishable key is safe for the app when RLS is enabled.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=foodfusion://reset-password

# Optional FoodFusion image analysis endpoint.
EXPO_PUBLIC_FOOD_SCAN_ENDPOINT=http://127.0.0.1:3333/scan-food
# Optional explicit recipe bridge base URL. If blank, FoodFusion derives it from the scan endpoint.
EXPO_PUBLIC_RECIPE_MCP_ENDPOINT=http://127.0.0.1:3333
# Temporary non-secret access token for local-network phone testing only.
# Use the same value as FOODFUSION_SCAN_ACCESS_TOKEN on the local bridge.
EXPO_PUBLIC_FOOD_SCAN_ACCESS_TOKEN=

# Optional shopping bridge base URL. Keep retailer API credentials on that server, never in this mobile env file.
EXPO_PUBLIC_INSTACART_MCP_ENDPOINT=http://127.0.0.1:3334
