# Supabase client values. The publishable key is safe for the app when RLS is enabled.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=foodfusion://reset-password
EXPO_PUBLIC_SUPABASE_CONFIRM_REDIRECT_URL=https://foodfusion-ai-site.onrender.com/confirm
EXPO_PUBLIC_SUPABASE_RESET_REDIRECT_URL=https://foodfusion-ai-site.onrender.com/reset-password
EXPO_PUBLIC_SUPABASE_PASSWORD_RESET_REDIRECT_URL=https://foodfusion-ai-site.onrender.com/reset-password

# RevenueCat public SDK keys. These are client-side RevenueCat public API keys, not App Store shared secrets.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_RIOaBqqslDCNsXNRMcfLYjtUWjv
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_revenuecat_android_public_sdk_key
# Optional single fallback key if you only build one platform during development.
# EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_public_sdk_key
# RevenueCat entitlement: fusion_plus
# RevenueCat products: foodfusion_monthly, foodfusion_yearly
# Optional dev-only entitlement override. Works only when __DEV__ is true.
# EXPO_PUBLIC_DEV_FORCE_FUSION_PLUS=true

# Development and production: hosted FoodFusion analysis and recipe bridge.
EXPO_PUBLIC_FOOD_SCAN_ENDPOINT=https://foodfusion-ai-site.onrender.com/scan-food
EXPO_PUBLIC_RECIPE_MCP_ENDPOINT=https://foodfusion-ai-site.onrender.com
# EXPO_PUBLIC_FOOD_SCAN_ACCESS_TOKEN=your_public_app_token

# Production: hosted Render backend. OPENAI_API_KEY stays only on that server.
# Use the same public app token as FOODFUSION_SCAN_ACCESS_TOKEN on Render.
EXPO_PUBLIC_FOOD_SCAN_ACCESS_TOKEN=your_public_app_token

# Render server environment variables. Do not put OPENAI_API_KEY in the mobile app env.
# PORT is set automatically by Render.
OPENAI_API_KEY=your_openai_server_key
FOODFUSION_SCAN_ACCESS_TOKEN=your_public_app_token
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional Render-only recipe source keys. Do not prefix these with EXPO_PUBLIC.
SPOONACULAR_API_KEY=your_spoonacular_server_key
EDAMAM_APP_ID=your_edamam_server_app_id
EDAMAM_APP_KEY=your_edamam_server_app_key

# Optional shopping bridge base URL. Keep retailer API credentials on that server, never in this mobile env file.
EXPO_PUBLIC_INSTACART_MCP_ENDPOINT=http://127.0.0.1:3334
