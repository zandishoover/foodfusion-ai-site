# Supabase client values. The publishable key is safe for the app when RLS is enabled.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=foodfusion://reset-password

# Development: local FoodFusion image analysis bridge.
# EXPO_PUBLIC_FOOD_SCAN_ENDPOINT=http://127.0.0.1:3333/scan-food
# EXPO_PUBLIC_RECIPE_MCP_ENDPOINT=http://127.0.0.1:3333
# EXPO_PUBLIC_FOOD_SCAN_ACCESS_TOKEN=your_public_app_token

# Production: hosted Render backend. OPENAI_API_KEY stays only on that server.
# Use the same public app token as FOODFUSION_SCAN_ACCESS_TOKEN on Render.
EXPO_PUBLIC_FOOD_SCAN_ENDPOINT=https://YOUR_RENDER_URL/scan-food
EXPO_PUBLIC_RECIPE_MCP_ENDPOINT=https://YOUR_RENDER_URL
EXPO_PUBLIC_FOOD_SCAN_ACCESS_TOKEN=your_public_app_token

# Render server environment variables. Do not put OPENAI_API_KEY in the mobile app env.
# PORT is set automatically by Render.
OPENAI_API_KEY=your_openai_server_key
FOODFUSION_SCAN_ACCESS_TOKEN=your_public_app_token
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional shopping bridge base URL. Keep retailer API credentials on that server, never in this mobile env file.
EXPO_PUBLIC_INSTACART_MCP_ENDPOINT=http://127.0.0.1:3334
